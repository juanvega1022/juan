# Public site URL, used for auth and Stripe redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint for platform events (checkout, refunds).
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret of the Connect webhook endpoint (account.updated). Optional;
# payout status is also refreshed when a creator returns from onboarding.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
